@model AppTask.Models.Funcionario
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Novo funcionário"; var listaDepartamentos = ViewBag.DepartamentoId as IEnumerable<SelectListItem>; var listaGerentes = ViewBag.CodigoGerente as IEnumerable<SelectListItem>;
}
<div class="page-header"><div><p class="eyebrow">Funcionários / novo registro</p><h1>Novo funcionário</h1><p class="page-subtitle">Adicione uma pessoa ao diretório e vincule-a à estrutura correta.</p></div></div>
<div class="form-panel">
    <div class="form-panel__body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div><div class="form-grid">
                <div class="form-field"><label for="Nome" class="form-label">Nome completo</label><input id="Nome" name="Nome" value="@Model?.Nome" class="form-control" required autocomplete="name" /></div>
                <div class="form-field"><label for="Cargo" class="form-label">Cargo</label><input id="Cargo" name="Cargo" value="@Model?.Cargo" class="form-control" required /></div>
                <div class="form-field"><label for="DepartamentoId" class="form-label">Departamento</label><select id="DepartamentoId" name="DepartamentoId" class="form-select" required><option value="">Selecione um departamento</option>@if (listaDepartamentos != null) { foreach (var departamento in listaDepartamentos) {
                <option value="@departamento.Value" selected="@(departamento.Selected ? "selected" : null)">@departamento.Text</option>
                                } }
</select></div>
                <div class="form-field"><label for="CodigoGerente" class="form-label">Gerente direto</label><select id="CodigoGerente" name="CodigoGerente" class="form-select"><option value="">Selecione um departamento primeiro</option>@if (listaGerentes != null) { foreach (var gerente in listaGerentes) {
                <option value="@gerente.Value" selected="@(gerente.Selected ? "selected" : null)">@gerente.Text</option>
                                } }
</select><p class="form-help">A lista é filtrada pelo departamento.</p></div>
                <div class="form-field form-field--wide"><label class="form-check"><input type="checkbox" id="ehGerente" name="EhGerente" value="true" class="form-check-input" @(Model?.EhGerente == true ? "checked" : "") /><input type="hidden" name="EhGerente" value="false" /><span class="form-label">Este funcionário também é gerente</span></label></div>
                <div class="form-actions form-field--wide"><button type="submit" class="btn btn-primary">Salvar funcionário</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
     <script>const checkboxGerente=document.getElementById('ehGerente'),selectGerente=document.getElementById('CodigoGerente'),selectDepartamento=document.getElementById('DepartamentoId');function atualizar(){selectGerente.disabled=checkboxGerente.checked;if(checkboxGerente.checked)selectGerente.value='';}async function carregar(){if(!selectDepartamento.value)return;const resposta=await fetch(`/Funcionario/ObterGerentesPorDepartamento?departamentoId=${selectDepartamento.value}`);const gerentes=await resposta.json();selectGerente.innerHTML='<option value="">Nenhum / não se aplica</option>';gerentes.forEach(g=>selectGerente.add(new Option(g.nome,g.codigo)));}checkboxGerente.addEventListener('change',atualizar);selectDepartamento.addEventListener('change',carregar);atualizar();</script>
}
