@model IEnumerable<AppTask.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<h1 class="mb-4">Lista de Funcionários</h1>

<p>
    <a href="/Funcionario/Create" class="btn btn-success text-white">
        Novo funcionário
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Cargo</th>
            <th>Departamento</th>
            <th>É gerente?</th>
            <th>Gerente</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nome</td>
                <td>@item.Cargo</td>
                <td>@item.Departamento?.Nome</td>
                <td>@(item.EhGerente ? "Sim" : "Não")</td>
                <td>@(item.Gerente?.Nome ?? "—")</td>
                <td>
                    <a href="/Funcionario/Edit/@item.Codigo"
                       class="btn btn-primary btn-sm text-white">
                        Alterar
                    </a>

                    <a href="/Funcionario/Details/@item.Codigo"
                       class="btn btn-success btn-sm text-white">
                        Detalhes
                    </a>

                    <a href="/Funcionario/Delete/@item.Codigo"
                       class="btn btn-danger btn-sm text-white">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>