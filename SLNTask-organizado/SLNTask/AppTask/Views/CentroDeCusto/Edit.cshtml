@model AppTask.Models.CentroDeCusto
@{ ViewData["Title"] = "Editar centro de custo"; }
<div class="page-header"><div><p class="eyebrow">Finanças / manutenção</p><h1>Editar centro de custo</h1><p class="page-subtitle">Atualize a estrutura, o orçamento ou o responsável pelo centro.</p></div></div>
<div class="form-panel"><div class="form-panel__body"><form asp-action="Edit" method="post"><input type="hidden" asp-for="Codigo" /><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div><div class="form-grid">
<div class="form-field"><label asp-for="CodigoCentro" class="form-label">Código</label><input asp-for="CodigoCentro" class="form-control" maxlength="20" /><span asp-validation-for="CodigoCentro" class="field-validation-error"></span></div><div class="form-field"><label asp-for="Nome" class="form-label">Nome do centro</label><input asp-for="Nome" class="form-control" maxlength="100" /><span asp-validation-for="Nome" class="field-validation-error"></span></div>
<div class="form-field"><label asp-for="DepartamentoId" class="form-label">Departamento</label><select asp-for="DepartamentoId" class="form-select" asp-items="ViewBag.DepartamentoId"><option value="">Transversal / não vinculado</option></select></div><div class="form-field"><label asp-for="ResponsavelId" class="form-label">Responsável</label><select asp-for="ResponsavelId" class="form-select" asp-items="ViewBag.ResponsavelId"><option value="">Ainda não definido</option></select></div>
<div class="form-field"><label asp-for="OrcamentoMensal" class="form-label">Orçamento mensal</label><input asp-for="OrcamentoMensal" class="form-control" type="number" min="0" step="0.01" /></div><div class="form-field"><label asp-for="DataCriacao" class="form-label">Data de criação</label><input asp-for="DataCriacao" class="form-control" type="date" /></div>
<div class="form-field form-field--wide"><label asp-for="Descricao" class="form-label">Descrição</label><textarea asp-for="Descricao" class="form-control" rows="3" maxlength="250"></textarea></div><div class="form-field form-field--wide"><label class="form-check"><input asp-for="Ativo" class="form-check-input" /><span class="form-label">Centro ativo para novas alocações</span></label></div>
<div class="form-actions form-field--wide"><button type="submit" class="btn btn-primary">Salvar alterações</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></div></form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
