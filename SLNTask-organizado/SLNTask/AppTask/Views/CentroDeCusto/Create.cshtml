@model AppTask.Models.CentroDeCusto
@{ ViewData["Title"] = "Novo centro de custo"; }
<div class="page-header"><div><p class="eyebrow">Finanças / novo registro</p><h1>Novo centro de custo</h1><p class="page-subtitle">Cadastre uma unidade para organizar despesas, responsáveis e orçamento.</p></div></div>
<div class="form-panel"><div class="form-panel__body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div><div class="form-grid">
<div class="form-field"><label asp-for="CodigoCentro" class="form-label">Código</label><input asp-for="CodigoCentro" class="form-control" placeholder="Ex.: CC-TI-001" maxlength="20" /><p class="form-help">Use um padrão curto e único.</p><span asp-validation-for="CodigoCentro" class="field-validation-error"></span></div>
<div class="form-field"><label asp-for="Nome" class="form-label">Nome do centro</label><input asp-for="Nome" class="form-control" placeholder="Ex.: Desenvolvimento" maxlength="100" /><span asp-validation-for="Nome" class="field-validation-error"></span></div>
<div class="form-field"><label asp-for="DepartamentoId" class="form-label">Departamento</label><select asp-for="DepartamentoId" class="form-select" asp-items="ViewBag.DepartamentoId"><option value="">Transversal / não vinculado</option></select></div>
<div class="form-field"><label asp-for="ResponsavelId" class="form-label">Responsável</label><select asp-for="ResponsavelId" class="form-select" asp-items="ViewBag.ResponsavelId"><option value="">Ainda não definido</option></select></div>
<div class="form-field"><label asp-for="OrcamentoMensal" class="form-label">Orçamento mensal</label><input asp-for="OrcamentoMensal" class="form-control" type="number" min="0" step="0.01" placeholder="0,00" /><p class="form-help">Opcional. Informe em reais.</p></div>
<div class="form-field"><label asp-for="DataCriacao" class="form-label">Data de criação</label><input asp-for="DataCriacao" class="form-control" type="date" /></div>
<div class="form-field form-field--wide"><label asp-for="Descricao" class="form-label">Descrição <span class="form-help">opcional</span></label><textarea asp-for="Descricao" class="form-control" rows="3" maxlength="250" placeholder="Explique o objetivo ou escopo deste centro"></textarea></div>
<div class="form-field form-field--wide"><label class="form-check"><input asp-for="Ativo" class="form-check-input" /><span class="form-label">Centro ativo para novas alocações</span></label></div>
<div class="form-actions form-field--wide"><button type="submit" class="btn btn-primary">Salvar centro</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></div></form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
