@model AppTask.Models.CentroDeCusto
@{ ViewData["Title"] = "Detalhes do centro de custo"; }
<div class="page-header"><div><p class="eyebrow">Finanças / consulta</p><h1>@Model.Nome</h1><p class="page-subtitle">Detalhes cadastrais do centro de custo <strong>@Model.CodigoCentro</strong>.</p></div><a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-primary">Editar centro</a></div>
<div class="form-panel"><div class="form-panel__body"><div class="form-grid"><div class="form-field"><span class="form-label">Código</span><span class="cell-mono">@Model.CodigoCentro</span></div><div class="form-field"><span class="form-label">Status</span><span class="status-label @(Model.Ativo ? "" : "is-warning")">@(Model.Ativo ? "Ativo" : "Inativo")</span></div><div class="form-field"><span class="form-label">Departamento</span><span>@(Model.Departamento?.Nome ?? "Transversal")</span></div><div class="form-field"><span class="form-label">Responsável</span><span>@(Model.Responsavel?.Nome ?? "Não definido")</span></div><div class="form-field"><span class="form-label">Orçamento mensal</span><span class="cell-mono">@(Model.OrcamentoMensal.HasValue ? Model.OrcamentoMensal.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR")) : "Não informado")</span></div><div class="form-field"><span class="form-label">Criado em</span><span class="cell-mono">@Model.DataCriacao.ToString("dd/MM/yyyy")</span></div><div class="form-field form-field--wide"><span class="form-label">Descrição</span><span>@(Model.Descricao ?? "Sem descrição cadastrada.")</span></div><div class="form-actions form-field--wide"><a asp-action="Index" class="btn btn-outline-secondary">Voltar para centros</a></div></div></div></div>
