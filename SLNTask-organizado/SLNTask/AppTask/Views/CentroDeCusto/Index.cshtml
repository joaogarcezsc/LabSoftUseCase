@model IEnumerable<AppTask.Models.CentroDeCusto>
@{ ViewData["Title"] = "Centros de custo"; var registros = Model?.ToList() ?? new List<AppTask.Models.CentroDeCusto>(); }
<div class="page-header"><div><p class="eyebrow">Finanças / estrutura gerencial</p><h1>Centros de custo</h1><p class="page-subtitle">Organize áreas, responsáveis e limites mensais para entender onde os recursos são utilizados.</p></div><a asp-action="Create" class="btn btn-primary">+ Novo centro</a></div>
<div class="grid-toolbar"><span class="grid-toolbar__meta">@registros.Count.ToString("00") CENTROS · @(registros.Count(c => c.Ativo)) ATIVOS</span><input class="search-field" type="search" placeholder="Filtrar centros..." aria-label="Filtrar centros de custo" data-grid-search="#cost-centers-grid" /></div>
<div class="data-grid-wrap"><table class="data-grid" id="cost-centers-grid"><thead><tr><th>Código</th><th>Centro de custo</th><th>Departamento</th><th>Responsável</th><th>Orçamento mensal</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>@if (!registros.Any()) { <tr><td colspan="7"><div class="empty-state">Nenhum centro de custo cadastrado.<br /><a asp-action="Create">Criar o primeiro centro</a></div></td></tr> } @foreach (var item in registros) { <tr><td class="cell-mono">@item.CodigoCentro</td><td class="cell-primary">@item.Nome</td><td>@(item.Departamento?.Nome ?? "Transversal")</td><td>@(item.Responsavel?.Nome ?? "Não definido")</td><td class="cell-mono">@(item.OrcamentoMensal.HasValue ? item.OrcamentoMensal.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR")) : "—")</td><td><span class="status-label @(item.Ativo ? "" : "is-warning")">@(item.Ativo ? "Ativo" : "Inativo")</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a class="danger" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></td></tr> }</tbody></table></div>
