@model AppTask.Models.Incidente
@{
    ViewData["Title"] = "Novo incidente";
}
<div class="page-header"><div><p class="eyebrow">Incidentes / novo registro</p><h1>Novo incidente</h1><p class="page-subtitle">Registre uma ocorrência para que ela possa ser acompanhada até a resolução.</p></div></div>
<div class="form-panel">
    <div class="form-panel__body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div><div class="form-grid">
                <div class="form-field form-field--wide"><label asp-for="DescricaoProblema" class="form-label">Descrição do problema</label><input asp-for="DescricaoProblema" class="form-control" maxlength="250" placeholder="Descreva o que aconteceu" required /><span asp-validation-for="DescricaoProblema" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="DataIncidente" class="form-label">Data e hora</label><input asp-for="DataIncidente" type="datetime-local" class="form-control" required /><span asp-validation-for="DataIncidente" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="Resolvido" class="form-label">Situação</label><select asp-for="Resolvido" class="form-select" required><option value="">Selecione a situação</option><option value="sim">Resolvido</option><option value="nao">Em aberto</option></select><span asp-validation-for="Resolvido" class="field-validation-error"></span></div>
                <div class="form-field form-field--wide"><label asp-for="Solucao" class="form-label">Solução aplicada <span class="form-help">opcional</span></label><textarea asp-for="Solucao" class="form-control" maxlength="250" rows="4" placeholder="Registre a solução ou os próximos passos"></textarea><span asp-validation-for="Solucao" class="field-validation-error"></span></div>
                <div class="form-actions form-field--wide"><button type="submit" class="btn btn-primary">Salvar incidente</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
