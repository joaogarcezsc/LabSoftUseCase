@model IEnumerable<AppTask.Models.Incidente>
@{
    ViewData["Title"] = "Incidentes"; var registros = Model?.ToList() ?? new List<AppTask.Models.Incidente>();
}
<div class="page-header"><div><p class="eyebrow">Risco / continuidade</p><h1>Incidentes</h1><p class="page-subtitle">Registre ocorrências e acompanhe a resolução antes que afetem a operação.</p></div><a asp-action="Create" class="btn btn-primary">+ Novo incidente</a></div>
<div class="grid-toolbar"><span class="grid-toolbar__meta">@registros.Count.ToString("00") OCORRÊNCIAS</span><input class="search-field" type="search" placeholder="Filtrar incidentes..." aria-label="Filtrar incidentes" data-grid-search="#incidents-grid" /></div>
<div class="data-grid-wrap"><table class="data-grid" id="incidents-grid"><thead><tr><th>ID</th><th>Problema reportado</th><th>Data</th><th>Solução</th><th>Situação</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach (var item in registros) { var resolvido = item.Resolvido?.ToLowerInvariant() == "sim" || item.Resolvido?.ToLowerInvariant() == "true";
<tr><td>#@item.Codigo.ToString("0000")</td><td class="cell-primary">@item.DescricaoProblema</td><td class="cell-mono">@item.DataIncidente</td><td class="cell-muted">@(item.Solucao ?? "Aguardando registro")</td><td><span class="status-label @(resolvido ? "" : "is-warning")">@(resolvido ? "Resolvido" : "Em aberto")</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a class="danger" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></td></tr>
}
</tbody></table></div>
