@model IEnumerable<AppTask.Models.Tarefa>
@using System.Globalization
@{
    ViewData["Title"] = "Tarefas";
    var tarefas = Model?.ToList() ?? new List<AppTask.Models.Tarefa>();
}
<div class="page-header">
    <div><p class="eyebrow">Operação / acompanhamento</p><h1>Tarefas</h1><p class="page-subtitle">Acompanhe o trabalho em curso, prazos e responsáveis em uma única visão operacional.</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Nova tarefa</a>
</div>
<div class="grid-toolbar">
    <span class="grid-toolbar__meta">@tarefas.Count.ToString("00") REGISTROS · ATUALIZADO AGORA</span>
    <div class="grid-tools"><input class="search-field" type="search" placeholder="Filtrar tarefas..." aria-label="Filtrar tarefas" data-grid-search="#tasks-grid" /><button class="btn btn-outline-secondary" type="button" title="Filtro avançado">Filtros +</button></div>
</div>
<div class="data-grid-wrap">
    <table class="data-grid" id="tasks-grid">
        <thead><tr><th>ID</th><th>Descrição</th><th>Responsável</th><th>Planejada</th><th>Prazo</th><th>Status</th><th>Início</th><th>Fim</th><th class="text-end">Ações</th></tr></thead>
        <tbody>
            @if (!tarefas.Any())
            {
                <tr><td colspan="9"><div class="empty-state">Nenhuma tarefa cadastrada.<br /><a asp-action="Create">Criar a primeira tarefa</a></div></td></tr>
            }
            @foreach (var item in tarefas)
            {
                var status = item.StatusTarefa?.ToLowerInvariant() ?? "";
                var statusClass = status.Contains("cancel") ? "is-danger" : (status.Contains("pend") || status.Contains("aguard") ? "is-warning" : "");
                <tr><td>#@item.Codigo.ToString("0000")</td><td class="cell-primary">@item.Descricao</td><td>@(item.Funcionario?.Nome ?? "Não atribuído")</td><td class="cell-mono">@item.DataPlanejada.ToString("dd/MM/yyyy")</td><td class="cell-mono">@item.Prazo</td><td><span class="status-label @statusClass">@item.StatusTarefa</span></td><td class="cell-mono">@(item.DataIniciada?.ToString("dd/MM/yy") ?? "—")</td><td class="cell-mono">@(item.DataFinalizada?.ToString("dd/MM/yy") ?? "—")</td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Codigo" title="Alterar">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo" title="Detalhes">Ver</a><button class="danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Codigo" data-descricao="@item.Descricao" title="Excluir">Excluir</button></div></td></tr>
            }
        </tbody>
    </table>
</div>
<div class="grid-toolbar" style="margin-top:14px"><span class="grid-toolbar__meta">MOSTRANDO @tarefas.Count DE @tarefas.Count</span><span class="grid-toolbar__meta">ESC para limpar busca · ações aparecem ao passar o mouse</span></div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="deleteModalLabel">Excluir tarefa?</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body">A tarefa <strong id="tarefaDescricao"></strong> será removida permanentemente.</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><form id="deleteForm" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Sim, excluir</button></form></div></div></div></div>
@section Scripts {
    <script>document.getElementById('deleteModal')?.addEventListener('show.bs.modal', function (event) { const button = event.relatedTarget; document.getElementById('tarefaDescricao').textContent = button.dataset.descricao; document.getElementById('deleteForm').action = '/Tarefa/Delete/' + button.dataset.id; });</script>
}
