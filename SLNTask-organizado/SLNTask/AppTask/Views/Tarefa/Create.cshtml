@model AppTask.Models.Tarefa
@{
    ViewData["Title"] = "Nova tarefa";
}
<div class="page-header"><div><p class="eyebrow">Tarefas / novo registro</p><h1>Nova tarefa</h1><p class="page-subtitle">Cadastre o trabalho, defina o prazo e atribua um responsável.</p></div></div>
<div class="form-panel">
    <div class="form-panel__body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div><div class="form-grid">
                <div class="form-field form-field--wide"><label asp-for="Descricao" class="form-label">Descrição da tarefa</label><input asp-for="Descricao" class="form-control" placeholder="Ex.: Homologar release 1.0" autocomplete="off" /><span asp-validation-for="Descricao" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="DataPlanejada" class="form-label">Data planejada</label><input asp-for="DataPlanejada" type="date" class="form-control" /><span asp-validation-for="DataPlanejada" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="FuncionarioId" class="form-label">Responsável</label><select asp-for="FuncionarioId" class="form-select" asp-items="ViewBag.FuncionarioId"><option value="">Selecione um responsável</option></select><span asp-validation-for="FuncionarioId" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="StatusTarefa" class="form-label">Status</label><select asp-for="StatusTarefa" class="form-select"><option value="">Selecione o status</option><option value="Pendente">Pendente</option><option value="Em Andamento">Em Andamento</option><option value="Concluída">Concluída</option><option value="Cancelada">Cancelada</option></select><span asp-validation-for="StatusTarefa" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="Prazo" class="form-label">Prazo</label><select asp-for="Prazo" class="form-select"><option value="">Selecione a situação</option><option value="Em dia">Em dia</option><option value="Em atraso">Em atraso</option><option value="Sem prazo">Sem prazo</option></select><span asp-validation-for="Prazo" class="field-validation-error"></span></div>
                <div class="form-field"><label asp-for="DataIniciada" class="form-label">Data de início <span class="form-help">opcional</span></label><input asp-for="DataIniciada" type="date" class="form-control" /></div>
                <div class="form-field"><label asp-for="DataFinalizada" class="form-label">Data de finalização <span class="form-help">opcional</span></label><input asp-for="DataFinalizada" type="date" class="form-control" /></div>
                <div class="form-actions form-field--wide"><button type="submit" class="btn btn-primary">Salvar tarefa</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
