@model IEnumerable<AppTask.Models.Departamento>
@{
    ViewData["Title"] = "Departamentos"; var registros = Model?.ToList() ?? new List<AppTask.Models.Departamento>();
}
<div class="page-header"><div><p class="eyebrow">Estrutura / organização</p><h1>Departamentos</h1><p class="page-subtitle">Unidades de negócio que organizam pessoas e responsabilidades.</p></div><a asp-action="Create" class="btn btn-primary">+ Novo departamento</a></div>
<div class="grid-toolbar"><span class="grid-toolbar__meta">@registros.Count.ToString("00") UNIDADES CADASTRADAS</span><input class="search-field" type="search" placeholder="Filtrar departamentos..." aria-label="Filtrar departamentos" data-grid-search="#departments-grid" /></div>
<div class="data-grid-wrap"><table class="data-grid" id="departments-grid"><thead><tr><th>ID</th><th>Nome do departamento</th><th>Sigla</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach (var item in registros) {
<tr><td>#@item.Codigo.ToString("0000")</td><td class="cell-primary">@item.Nome</td><td class="cell-mono">@item.Sigla</td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a class="danger" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></td></tr>
}
</tbody></table></div>
